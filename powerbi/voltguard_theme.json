{
  "name": "VoltGuard",
  "dataColors": ["#2563EB", "#C2410C", "#0D9488", "#7C3AED", "#F5B700", "#0B3954", "#64748B", "#15803D"],
  "background": "#FFFFFF",
  "foreground": "#0F1B2A",
  "tableAccent": "#087E8B",
  "good": "#15803D",
  "neutral": "#A16207",
  "bad": "#C2410C",
  "maximum": "#C2410C",
  "center": "#F5B700",
  "minimum": "#EDF1F6",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0F1B2A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F1B2A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#556273" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0B3954" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#DBE2EA" } }, "radius": 12 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "dropShadow": [{ "show": true, "preset": "Bottom", "color": { "solid": { "color": "#101828" } }, "transparency": 92 }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }] } }
  }
}

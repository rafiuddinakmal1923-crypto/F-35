# Copy to .env (`make.ps1 setup` does this and fills in the generated secrets).
# Never commit .env.

# --- Storage: everything bulky lives on D: (prompt 7.3) -------------------------------
DATA_ROOT=D:/VoltGuard              # datasets, uploads, photos, PDFs, logs, audit anchor, mlruns
# Ollama models live in the ollama_models Docker volume (on D: once Docker's disk image is there).
HF_HOME=D:/VoltGuard/models/hf      # embedding model cache

# --- Language model --------------------------------------------------------------------
LLM_MODE=ollama                     # or: mock (deterministic templates, no model needed)
LLM_MODEL=qwen2.5:7b-instruct       # ~7B open-weight instruct model, Apache 2.0
LLM_FALLBACK_MODEL=phi3.5           # smaller model for low-memory machines, MIT
REPORT_MODE=predrafted              # or: mock, live (live needs a GPU to fit the 5-minute demo)
EMBED_MODEL=intfloat/multilingual-e5-small   # MIT; English and Bahasa Melayu
OLLAMA_URL=http://ollama:11434

# --- Messaging and public link ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=                 # from @BotFather; empty = the bot runs inside the app (Dispatch page, inspector Messages tab)
TELEGRAM_CHAT_IDS=                  # optional: team_id=chat_id or user_id=chat_id pairs (e.g. a team group chat), comma separated
TELEGRAM_POLL=on                    # off = send only; button presses in Telegram then do nothing
WEB_PORT=8080                       # laptop port for the web app (http://localhost:WEB_PORT); pick another if it is taken
PUBLIC_BASE_URL=                    # set to the tunnel address for case links (make.ps1 tunnel writes it)

# --- Database --------------------------------------------------------------------------
POSTGRES_PASSWORD=                  # generated by make.ps1 setup
APP_DB_PASSWORD=                    # role voltguard_app: API connections, row-level security applies
POWERBI_DB_PASSWORD=                # role voltguard_powerbi: read-only, rpt_ views only
DATABASE_URL=postgresql://voltguard_app:${APP_DB_PASSWORD}@db:5432/voltguard
ADMIN_DATABASE_URL=postgresql://voltguard:${POSTGRES_PASSWORD}@db:5432/voltguard
DB_HOST_PORT=15432                  # laptop port for Power BI (127.0.0.1 only); pick another if it is taken

# --- Sign-in and demo ------------------------------------------------------------------
JWT_SECRET=                         # generated by make.ps1 setup
DEMO_MODE=1                         # 1 = shortened reminder/escalation timers (2 and 4 minutes)
DEMO_PASSWORDS=                     # generated by make.ps1 demo: user=password pairs, comma separated

# --- Tunnel (prompt 7.4) ---------------------------------------------------------------
TUNNEL_HOSTNAME=                    # named tunnel hostname, e.g. voltguard.example.com
TUNNEL_TOKEN=                       # token of a tunnel created in the Cloudflare dashboard (make.ps1 tunnel-token)

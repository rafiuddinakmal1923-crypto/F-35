# One entry point for the web app and the API (lite profile). Cloudflare Tunnel points here.
:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(self), camera=(self)"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	# /metrics stays internal: it is not routed here (Prometheus scrapes api:8000 directly).
	handle {
		reverse_proxy web:80
	}
}
